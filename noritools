<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Board Lookup</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
:root{--bg:#f3f5f4;--surface:#fff;--ink:#17252a;--muted:#5d6e73;--line:#d3dcdb;--accent:#0f6b5c;--accent-ink:#fff;--hl:#ffe9a8;--sel:#dcf1ec;--ok-bg:#dcf1e6;--ok:#14633f;--bad-bg:#fbe0dc;--bad:#9a2a1c;--warn-bg:#fdf0cf;--warn:#7a5a00;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10181a;--surface:#182326;--ink:#e6eeee;--muted:#93a6a9;--line:#2c3c40;--accent:#4cc3ad;--accent-ink:#06201b;--hl:#5a4a12;--sel:#1d3a36;--ok-bg:#16382a;--ok:#7be0a8;--bad-bg:#432019;--bad:#ff9d8e;--warn-bg:#43360d;--warn:#f2cf6b;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#10181a;--surface:#182326;--ink:#e6eeee;--muted:#93a6a9;--line:#2c3c40;--accent:#4cc3ad;--accent-ink:#06201b;--hl:#5a4a12;--sel:#1d3a36;--ok-bg:#16382a;--ok:#7be0a8;--bad-bg:#432019;--bad:#ff9d8e;--warn-bg:#43360d;--warn:#f2cf6b;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 "IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif}
header{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:env(safe-area-inset-top,0px);z-index:5}
.bar{max-width:1100px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.brand{font-weight:600;font-size:17px;margin-right:auto}
nav{display:flex;gap:4px}
nav a{padding:8px 14px;border-radius:6px;color:var(--muted);text-decoration:none;font-weight:500}
nav a.on{background:var(--accent);color:var(--accent-ink)}
nav a.off{opacity:.45;pointer-events:none}
main{max-width:1100px;margin:0 auto;padding:28px 20px 60px}
h1{font-size:24px;margin:0 0 4px;font-weight:600}
.sub{color:var(--muted);margin:0 0 22px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:22px}
.drop{border:2px dashed var(--line);border-radius:8px;padding:34px 20px;text-align:center;cursor:pointer;transition:border-color .15s,background .15s}
.drop.over,.drop:hover,.drop:focus-visible{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 7%,transparent);outline:none}
.drop b{display:block;font-size:17px;margin-bottom:4px}
.drop span{color:var(--muted)}
button{font:inherit;font-weight:500;border:1px solid var(--accent);background:var(--accent);color:var(--accent-ink);padding:9px 18px;border-radius:6px;cursor:pointer}
button.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
button.danger{background:transparent;color:var(--bad);border-color:var(--bad)}
button.danger.arm{background:var(--bad);color:var(--surface)}
button.sm{padding:5px 12px;font-size:13px}
button:focus-visible,input:focus-visible,a:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.msgs{display:grid;gap:8px;margin-top:14px}
.msg{padding:9px 14px;border-radius:6px;font-weight:500}
.msg.ok{background:var(--ok-bg);color:var(--ok)}.msg.err{background:var(--bad-bg);color:var(--bad)}
.cols{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 0}
.cols code{background:var(--bg);border:1px solid var(--line);padding:2px 8px;border-radius:4px;font-size:13px}
.actions{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}
.files{margin-top:22px}
.files .head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap}
.frow{display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin-bottom:8px}
.frow .n{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}
.frow .c{color:var(--muted);white-space:nowrap}
.scroll{overflow:auto;max-height:62vh;border:1px solid var(--line);border-radius:8px;background:var(--surface)}
table{border-collapse:collapse;width:100%;min-width:860px;font-size:14px}
th,td{padding:9px 12px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
th{background:var(--bg);font-weight:600;position:sticky;top:0;z-index:1}
th.sel{background:var(--sel)}
td.sel{background:color-mix(in srgb,var(--sel) 55%,transparent)}
tr:last-child td{border-bottom:0}
mark{background:var(--hl);color:inherit;border-radius:2px;padding:0 1px}
.pill{display:inline-block;padding:1px 9px;border-radius:99px;font-size:13px;font-weight:500;background:var(--warn-bg);color:var(--warn)}
.pill.act{background:var(--ok-bg);color:var(--ok)}.pill.exp{background:var(--bad-bg);color:var(--bad)}
.search{display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:end;margin-bottom:14px}
label{display:block;font-weight:500;margin-bottom:5px}
input[type=text],textarea{width:100%;font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);resize:vertical}
.meta{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;color:var(--muted);margin:0 0 10px}
.empty{padding:36px 20px;text-align:center;color:var(--muted)}
.grp{margin-bottom:22px}
.ghead{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:8px}
.ghead h2{font-size:16px;margin:0;font-weight:600}
.ghead .gc{color:var(--muted);margin-right:auto}
.gscroll{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:var(--surface)}
.gscroll.none{padding:14px;color:var(--muted)}
details.copybar{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin-bottom:14px}
details.copybar summary{cursor:pointer;font-weight:600}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.chip{display:inline-flex;align-items:center;gap:6px;margin:0;font-weight:400;border:1px solid var(--line);border-radius:6px;padding:5px 10px;cursor:pointer;background:var(--bg)}
.chip:has(input:checked){border-color:var(--accent);background:var(--sel)}
.cact{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.cact label{display:inline-flex;align-items:center;gap:6px;margin:0;font-weight:400}
#copied{font-weight:500;color:var(--ok)}#copied.err{color:var(--bad)}
.ws.full{position:fixed;inset:0;z-index:30;background:var(--bg);padding:calc(14px + env(safe-area-inset-top,0px)) 20px calc(14px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;overflow:hidden}
.ws.full #results{flex:1;min-height:0;overflow:auto}
.ws.full .scroll{flex:1;max-height:none;min-height:0}
.ws.full table{min-width:0}
@media(max-width:700px){.search{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header><div class="bar">
  <div class="brand">Board Lookup</div>
  <nav>
    <a href="#ingest" id="nav-ingest">1. Ingestion</a>
    <a href="#search" id="nav-search" class="off">2. Search results</a>
  </nav>
</div></header>

<main>
<section id="view-ingest">
  <h1>Ingest Excel files</h1>
  <p class="sub">Add one or more files. They are read in your browser only and nothing is uploaded anywhere.</p>
  <div class="panel">
    <div class="drop" id="drop" tabindex="0" role="button" aria-label="Choose Excel files">
      <b>Drop Excel files here, or click to choose</b>
      <span>.xlsx, .xls or .csv. You can select several files, and add more later.</span>
    </div>
    <input type="file" id="file" accept=".xlsx,.xls,.csv" multiple hidden>
    <div class="msgs" id="status"></div>
    <div style="margin-top:18px"><b>Expected columns</b>
      <div class="cols" id="cols"></div></div>
  </div>
  <div class="files" id="files"></div>
  <div id="preview" style="margin-top:22px"></div>
</section>

<section id="view-search" hidden>
  <h1>Search results</h1>
  <p class="sub" id="loaded"></p>
  <div class="ws" id="ws">
    <div class="search">
      <div><label for="q-ic">Board IC No (one per line)</label><textarea id="q-ic" rows="5" placeholder="850412-14-5678&#10;900101-10-1234&#10;751231-08-4321" autocomplete="off"></textarea></div>
      <div><label for="q-name">Board first name</label><input type="text" id="q-name" placeholder="e.g. Ahmad" autocomplete="off"></div>
      <button class="ghost" id="clear">Clear</button>
    </div>
    <details class="copybar" open>
      <summary>Copy columns</summary>
      <div class="chips" id="chips"></div>
      <div class="cact">
        <button id="copy">Copy results</button>
        <label><input type="checkbox" id="hdr" checked> Include header row</label>
        <button class="ghost sm" id="c-all">Select all</button>
        <button class="ghost sm" id="c-none">Select none</button>
        <span id="copied" role="status"></span>
      </div>
    </details>
    <div class="meta"><span id="count"></span><button class="ghost sm" id="fs">Full screen</button></div>
    <div id="results"></div>
  </div>
</section>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
(function(){
var COLS=["MYCO_ID","TP_NAME","EXPIRY_DATE","STATUS","REGISTRATION_DATE","BOARD_FIRST_NAME","BOARD_DESIGNATION","BOARD_IC_NO"];
var MAX_ROWS=500;
var files=[],rows=[],nextId=1,hits=[],sel={},armTimer=null;
COLS.forEach(function(c){sel[c]=true});sel.FILE=false;
var $=function(id){return document.getElementById(id)};

function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function normKey(k){return String(k).trim().toUpperCase().replace(/[\s\-]+/g,"_")}
function normIC(s){return String(s).replace(/[^0-9A-Za-z]/g,"").toLowerCase()}
function fmt(v){
  if(v instanceof Date&&!isNaN(v)){
    var d=new Date(v.getTime()+300000);
    return ("0"+d.getDate()).slice(-2)+"/"+("0"+(d.getMonth()+1)).slice(-2)+"/"+d.getFullYear();
  }
  return v==null?"":String(v).trim();
}
function dispCols(){return files.length>1?COLS.concat("FILE"):COLS}

$("cols").innerHTML=COLS.map(function(c){return "<code>"+c+"</code>"}).join("");

/* ---------- ingestion ---------- */
var drop=$("drop"),input=$("file");
drop.addEventListener("click",function(){input.click()});
drop.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();input.click()}});
["dragover","dragenter"].forEach(function(t){drop.addEventListener(t,function(e){e.preventDefault();drop.classList.add("over")})});
["dragleave","drop"].forEach(function(t){drop.addEventListener(t,function(e){e.preventDefault();drop.classList.remove("over")})});
drop.addEventListener("drop",function(e){if(e.dataTransfer.files.length)addFiles(e.dataTransfer.files)});
input.addEventListener("change",function(){if(input.files.length)addFiles(input.files);input.value=""});

function readOne(file){
  return new Promise(function(resolve){
    var r=new FileReader();
    r.onerror=function(){resolve({err:file.name+": could not be read."})};
    r.onload=function(e){
      try{
        var wb=XLSX.read(new Uint8Array(e.target.result),{type:"array",cellDates:true});
        var raw=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{defval:""});
        if(!raw.length){resolve({err:file.name+": the first sheet has no data rows."});return}
        var keys={};Object.keys(raw[0]).forEach(function(k){keys[normKey(k)]=k});
        var missing=COLS.filter(function(c){return !(c in keys)});
        if(missing.length){resolve({err:file.name+": missing columns "+missing.join(", ")+"."});return}
        var out=raw.map(function(o){
          var x={};COLS.forEach(function(c){x[c]=fmt(o[keys[c]])});
          x._ic=normIC(x.BOARD_IC_NO);x._name=x.BOARD_FIRST_NAME.toLowerCase();x.FILE=file.name;
          return x;
        }).filter(function(x){return COLS.some(function(c){return x[c]!==""})});
        resolve({name:file.name,rows:out});
      }catch(err){resolve({err:file.name+": could not be read as Excel or CSV."})}
    };
    r.readAsArrayBuffer(file);
  });
}

function addFiles(list){
  Promise.all(Array.prototype.map.call(list,readOne)).then(function(res){
    var msgs=[];
    res.forEach(function(r){
      if(r.err){msgs.push('<div class="msg err">'+esc(r.err)+"</div>");return}
      var replaced=false;
      files=files.filter(function(f){if(f.name===r.name){replaced=true;return false}return true});
      files.push({id:nextId++,name:r.name,rows:r.rows});
      msgs.push('<div class="msg ok">'+esc(r.name)+": "+r.rows.length.toLocaleString()+" rows "+(replaced?"reloaded (replaced the earlier copy).":"added.")+"</div>");
    });
    $("status").innerHTML=msgs.join("");
    refresh();
  });
}

function refresh(){
  rows=[].concat.apply([],files.map(function(f){return f.rows}));
  renderFiles();renderChips();
  $("nav-search").classList.toggle("off",!files.length);
  if(!files.length&&location.hash==="#search")location.hash="#ingest";else route();
}

function renderFiles(){
  var box=$("files"),prev=$("preview");
  if(!files.length){box.innerHTML="";prev.innerHTML="";return}
  box.innerHTML='<div class="head"><b>Loaded files ('+files.length+") · "+rows.length.toLocaleString()+' rows in total</b><button class="danger sm" id="del-all">Delete all</button></div>'
    +files.map(function(f){return '<div class="frow"><span class="n" title="'+esc(f.name)+'">'+esc(f.name)+'</span><span class="c">'+f.rows.length.toLocaleString()+' rows</span><button class="danger sm" data-del="'+f.id+'" aria-label="Delete '+esc(f.name)+'">Delete</button></div>'}).join("");
  prev.innerHTML='<div class="meta"><span>Preview: first 5 rows</span></div><div class="scroll">'+table(rows.slice(0,5),"","")+'</div><div class="actions"><button id="go">Go to search</button></div>';
  $("go").addEventListener("click",function(){location.hash="#search"});
}
$("files").addEventListener("click",function(e){
  var b=e.target.closest("button");if(!b)return;
  if(b.dataset.del){
    var id=+b.dataset.del;files=files.filter(function(f){return f.id!==id});
    $("status").innerHTML="";refresh();return;
  }
  if(b.id==="del-all"){
    if(!b.classList.contains("arm")){
      b.classList.add("arm");b.textContent="Click again to delete all";
      clearTimeout(armTimer);armTimer=setTimeout(function(){b.classList.remove("arm");b.textContent="Delete all"},3000);
      return;
    }
    clearTimeout(armTimer);files=[];$("status").innerHTML="";hits=[];refresh();
  }
});

/* ---------- table ---------- */
function hl(text,q){
  if(!q)return esc(text);
  var i=text.toLowerCase().indexOf(q);
  if(i<0)return esc(text);
  return esc(text.slice(0,i))+"<mark>"+esc(text.slice(i,i+q.length))+"</mark>"+esc(text.slice(i+q.length));
}
function hlIC(text,q){
  if(!q)return esc(text);
  var map=[],plain="";
  for(var i=0;i<text.length;i++){if(/[0-9A-Za-z]/.test(text[i])){map.push(i);plain+=text[i].toLowerCase()}}
  var p=plain.indexOf(q);
  if(p<0)return esc(text);
  var s=map[p],e=map[p+q.length-1]+1;
  return esc(text.slice(0,s))+"<mark>"+esc(text.slice(s,e))+"</mark>"+esc(text.slice(e));
}
function table(list,qIC,qName){
  var cols=dispCols();
  var h="<table><thead><tr>"+cols.map(function(c){return '<th class="'+(sel[c]?"sel":"")+'">'+c+"</th>"}).join("")+"</tr></thead><tbody>";
  list.forEach(function(r){
    h+="<tr>"+cols.map(function(c){
      var v=r[c],k=sel[c]?' class="sel"':"";
      if(c==="STATUS"){var s=v.toLowerCase();var p=/^(active|aktif|valid)/.test(s)?" act":/(expire|inactive|cancel|revok|terminat|suspend)/.test(s)?" exp":"";return "<td"+k+'><span class="pill'+p+'">'+esc(v||"-")+"</span></td>"}
      if(c==="BOARD_IC_NO")return "<td"+k+">"+hlIC(v,qIC)+"</td>";
      if(c==="BOARD_FIRST_NAME")return "<td"+k+">"+hl(v,qName)+"</td>";
      return "<td"+k+">"+esc(v)+"</td>";
    }).join("")+"</tr>";
  });
  return h+"</tbody></table>";
}

/* ---------- search ---------- */
var groups=[];
function plural(n,w){return n+" "+w+(n===1?"":"s")}
function search(){
  var tokens=[],seen={};
  $("q-ic").value.split(/[\s,;]+/).forEach(function(t){var n=normIC(t);if(n&&!seen[n]){seen[n]=1;tokens.push({n:n,raw:t})}});
  var nameRaw=$("q-name").value.trim().toLowerCase();
  var out=$("results"),count=$("count");
  $("copied").textContent="";
  groups=[];hits=[];
  if(!tokens.length&&!nameRaw){
    count.textContent="";
    out.innerHTML='<div class="panel empty">Enter one or more Board IC numbers, or a first name, to search '+rows.length.toLocaleString()+" rows.</div>";
    return;
  }
  var okName=function(r){return !nameRaw||r._name.indexOf(nameRaw)>-1};
  if(tokens.length){
    tokens.forEach(function(t){groups.push({token:t.n,label:t.raw,rows:rows.filter(function(r){return r._ic.indexOf(t.n)>-1&&okName(r)})})});
  }else{
    var map={};
    rows.forEach(function(r){
      if(!okName(r))return;
      var k=r._ic||"(no ic)";
      if(!map[k]){map[k]={token:"",label:r.BOARD_IC_NO||"No IC",rows:[]};groups.push(map[k])}
      map[k].rows.push(r);
    });
  }
  groups.forEach(function(g){hits=hits.concat(g.rows)});
  var found=groups.filter(function(g){return g.rows.length}).length;
  count.textContent=plural(hits.length,"row")+" · "+(tokens.length?found+" of "+groups.length+" IC found":plural(groups.length,"IC"));
  if(!groups.length){out.innerHTML='<div class="panel empty">No rows match. Check the spelling, or try fewer characters.</div>';return}
  var budget=MAX_ROWS,html="";
  groups.forEach(function(g,i){
    var shown=g.rows.slice(0,Math.max(budget,0));budget-=shown.length;
    var names=[];g.rows.forEach(function(r){if(r.BOARD_FIRST_NAME&&names.indexOf(r.BOARD_FIRST_NAME)<0)names.push(r.BOARD_FIRST_NAME)});
    html+='<section class="grp"><div class="ghead"><h2>'+esc(g.label)+'</h2><span class="gc">'+esc(names.slice(0,3).join(", ")+(names.length?" · ":"")+plural(g.rows.length,"row"))+"</span>"
      +(g.rows.length?'<button class="ghost sm" data-g="'+i+'">Copy this IC</button>':"")+"</div>";
    if(!g.rows.length)html+='<div class="gscroll none">No rows match this IC.</div>';
    else if(!shown.length)html+='<div class="gscroll none">Not shown because of the display limit. Copy still includes these rows.</div>';
    else html+='<div class="gscroll">'+table(shown,g.token,nameRaw)+"</div>";
    html+="</section>";
  });
  if(hits.length>MAX_ROWS)html+='<p class="sub">Showing the first '+MAX_ROWS+" rows. Copy still includes all "+hits.length.toLocaleString()+".</p>";
  out.innerHTML=html;
}
function copyRows(gs){
  var cols=dispCols().filter(function(c){return sel[c]});
  if(!cols.length){note("Choose at least one column.",true);return}
  var clean=function(v){return String(v).replace(/[\t\r\n]+/g," ")};
  var lines=[],n=0;
  if($("hdr").checked)lines.push(cols.join("\t"));
  gs.forEach(function(g,i){
    if(i>0)lines.push("");
    if(!g.rows.length){lines.push(g.label+"\tNOT FOUND");return}
    g.rows.forEach(function(r){n++;lines.push(cols.map(function(c){return clean(r[c])}).join("\t"))});
  });
  clip(lines.join("\n")).then(function(){note("Copied "+plural(n,"row")+" in "+plural(gs.length,"IC group")+", "+plural(cols.length,"column")+".")},function(){note("Copy was blocked by the browser. Try again after clicking the page.",true)});
}
$("results").addEventListener("click",function(e){
  var b=e.target.closest("button[data-g]");if(!b)return;
  copyRows([groups[+b.dataset.g]]);
});
$("q-ic").addEventListener("input",search);
$("q-name").addEventListener("input",search);
$("clear").addEventListener("click",function(){$("q-ic").value="";$("q-name").value="";search();$("q-ic").focus()});

/* ---------- copy columns ---------- */
function renderChips(){
  $("chips").innerHTML=dispCols().map(function(c){
    return '<label class="chip"><input type="checkbox" data-col="'+c+'"'+(sel[c]?" checked":"")+"> "+c+"</label>";
  }).join("");
}
$("chips").addEventListener("change",function(e){
  var c=e.target.dataset.col;if(!c)return;
  sel[c]=e.target.checked;search();
});
function setAll(v){dispCols().forEach(function(c){sel[c]=v});renderChips();search()}
$("c-all").addEventListener("click",function(){setAll(true)});
$("c-none").addEventListener("click",function(){setAll(false)});

function note(text,err){var el=$("copied");el.textContent=text;el.className=err?"err":""}
function clip(text){
  if(navigator.clipboard&&window.isSecureContext){
    return navigator.clipboard.writeText(text).catch(function(){return legacy(text)});
  }
  return legacy(text);
}
function legacy(text){
  return new Promise(function(res,rej){
    var t=document.createElement("textarea");t.value=text;t.style.cssText="position:fixed;opacity:0";
    document.body.appendChild(t);t.focus();t.select();t.setSelectionRange(0,t.value.length);
    var ok=false;try{ok=document.execCommand("copy")}catch(e){}
    document.body.removeChild(t);ok?res():rej();
  });
}
$("copy").addEventListener("click",function(){
  if(!groups.length){note("Nothing to copy. Run a search first.",true);return}
  copyRows(groups);
});

/* ---------- full screen ---------- */
function setFull(on){
  $("ws").classList.toggle("full",on);
  document.body.style.overflow=on?"hidden":"";
  $("fs").textContent=on?"Exit full screen":"Full screen";
}
$("fs").addEventListener("click",function(){setFull(!$("ws").classList.contains("full"))});
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&$("ws").classList.contains("full"))setFull(false)});

/* ---------- navigation ---------- */
function route(){
  var want=location.hash==="#search"&&rows.length?"search":"ingest";
  if(location.hash==="#search"&&!rows.length)history.replaceState(null,"","#ingest");
  if(want==="ingest")setFull(false);
  $("view-ingest").hidden=want!=="ingest";
  $("view-search").hidden=want!=="search";
  $("nav-ingest").classList.toggle("on",want==="ingest");
  $("nav-search").classList.toggle("on",want==="search");
  if(want==="search"){
    $("loaded").textContent=rows.length.toLocaleString()+" rows from "+files.length+" file"+(files.length===1?"":"s")+".";
    renderChips();search();
  }
}
window.addEventListener("hashchange",route);
renderChips();route();
})();
</script>
</body>
</html>
